@page "/login"
@using MyMedia.Shared.DTOs
@using MyMedia.Shared.Services
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<div class="login-container">
    <div class="col-md-5 col-lg-4">

        <div class="card login-card animate__animated animate__fadeInUp">

            <div class="login-header">
                <i class="bi bi-person-circle login-icon"></i>
                <h3 class="fw-bold mb-0">Bem-vindo</h3>
                <small style="opacity: 0.8;">Insere os teus dados para continuar</small>
            </div>

            <div class="card-body p-4 p-md-5">
                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold small">EMAIL</label>
                        <div class="input-group">
                            <span class="input-group-text position-absolute" style="z-index: 10; padding-left: 15px;">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <InputText @bind-Value="loginModel.Email"
                                       class="form-control"
                                       style="padding-left: 45px;"
                                       placeholder="exemplo@email.com" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Email)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold small">PASSWORD</label>
                        <div class="input-group">
                            <span class="input-group-text position-absolute" style="z-index: 10; padding-left: 15px;">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <InputText @bind-Value="loginModel.Password"
                                       type="password"
                                       class="form-control"
                                       style="padding-left: 45px;"
                                       placeholder="••••••••" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small mt-1" />
                    </div>

                    <div class="d-grid gap-2 mt-5">
                        <button type="submit" class="btn btn-login">
                            ENTRAR <i class="bi bi-arrow-right-short"></i>
                        </button>
                    </div>

                </EditForm>

                @if (!string.IsNullOrEmpty(mensagem))
                {
                    <div class="alert alert-danger mt-4 d-flex align-items-center animate__animated animate__shakeX">
                        <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                        <div>@mensagem</div>
                    </div>
                }

                <div class="text-center mt-4 pt-3 border-top">
                    <span class="text-muted">Ainda não tens conta?</span>
                    <a href="registar" class="register-link ms-1">Cria uma agora</a>
                </div>

            </div>
        </div>

        <div class="text-center mt-4 text-muted small">
            &copy; @DateTime.Now.Year MyMedia Store. Todos os direitos reservados.
        </div>
    </div>
</div>

@code {
    private LoginDTO loginModel = new LoginDTO();
    private string mensagem = "";

    private async Task HandleLogin()
    {
        mensagem = "";

        // 1. Tenta obter o Token da API
        var token = await AuthService.Login(loginModel);

        // Verificamos se recebemos um token válido
        if (!string.IsNullOrEmpty(token) && token.Length > 20)
        {
            // 2. Guardar o token
            await LocalStorage.SetItemAsStringAsync("authToken", token);

            // 3. Notificar o sistema
            var customProvider = (CustomAuthStateProvider)AuthStateProvider;
            customProvider.NotificarUserLogin(token);

            // 4. Redirecionar
            Navigation.NavigateTo("/", forceLoad: false);
        }
        else
        {
            mensagem = "Email ou password incorretos.";
        }
    }
}