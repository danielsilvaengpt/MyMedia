@page "/produtos/editar/{id:int}"
@using MyMedia.Shared.Entities
@using MyMedia.Shared.Interfaces
@inject IProdutoService ProdutoService
@inject ICategoriaService CategoriaService
@inject IModoDispService ModoDispService
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Fornecedor")]


<div class="edit-container pt-4">
    <div class="container">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="page-title mb-0">
                <i class="bi bi-pencil-square text-warning me-2"></i> Editar Produto
            </h2>
            <a href="/meus-produtos" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                <i class="bi bi-arrow-left me-2"></i> Cancelar
            </a>
        </div>

        @if (isLoading)
        {
            <div class="d-flex justify-content-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (produto == null)
        {
            <div class="alert alert-warning shadow-sm rounded-4 p-4 text-center">
                <i class="bi bi-exclamation-circle fs-1 d-block mb-3"></i>
                <h5>Produto não encontrado.</h5>
                <a href="/meus-produtos" class="btn btn-primary mt-3">Voltar à lista</a>
            </div>
        }
        else
        {
            <EditForm Model="produto" OnValidSubmit="HandleUpdate">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-lg-8 mb-4">
                        <div class="custom-card h-100">
                            <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-card-text me-2"></i> Dados do Produto</h5>

                            <div class="mb-4">
                                <label class="form-label">Nome do Produto</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-tag-fill"></i></span>
                                    <InputText @bind-Value="produto.Titulo" class="form-control" />
                                </div>
                                <ValidationMessage For="@(() => produto.Titulo)" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Descrição</label>
                                <InputTextArea @bind-Value="produto.Descricao" class="form-control" rows="5" />
                                <ValidationMessage For="@(() => produto.Descricao)" class="text-danger small mt-1" />
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <label class="form-label">Preço Base (€)</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-currency-euro"></i></span>
                                        <InputNumber @bind-Value="produto.PrecoBase" class="form-control" />
                                    </div>
                                    <ValidationMessage For="@(() => produto.PrecoBase)" class="text-danger small mt-1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Stock Atual</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-box-seam"></i></span>
                                        <InputNumber @bind-Value="produto.Stock" class="form-control" />
                                    </div>
                                    <ValidationMessage For="@(() => produto.Stock)" class="text-danger small mt-1" />
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <label class="form-label">Categoria</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-grid-fill"></i></span>
                                        <InputSelect @bind-Value="produto.CategoriaId" class="form-select">
                                            <option value="0" disabled>-- Seleciona --</option>
                                            @foreach (var c in categorias)
                                            {
                                                <option value="@c.Id">@c.Nome</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <ValidationMessage For="@(() => produto.CategoriaId)" class="text-danger small mt-1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Formato</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-disc"></i></span>
                                        <InputSelect @bind-Value="produto.ModoDisponibilizacaoId" class="form-select">
                                            <option value="0" disabled>-- Seleciona --</option>
                                            @foreach (var m in modos)
                                            {
                                                <option value="@m.Id">@m.Nome</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <ValidationMessage For="@(() => produto.ModoDisponibilizacaoId)" class="text-danger small mt-1" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        
                        <div class="preview-card mb-4">
                            <h6 class="fw-bold mb-3 small text-uppercase text-muted">Imagem</h6>
                            
                            <div class="img-preview-box">
                                @if (!string.IsNullOrWhiteSpace(produto.ImageUrl))
                                {
                                    <img src="@produto.ImageUrl" class="img-preview"
                                         onerror="this.src='/images/placeholder.png'; this.onerror=null;" />
                                }
                                else
                                {
                                    <div class="text-center text-muted">
                                        <i class="bi bi-image fs-1 opacity-50"></i>
                                        <div class="small mt-2">Sem Imagem</div>
                                    </div>
                                }
                            </div>

                            <label class="form-label">Imagem do Produto</label>
                            <InputFile OnChange="CarregarImagem" class="form-control form-control-sm" accept=".jpg,.jpeg,.png" />
                            @* <InputText @bind-Value="produto.ImageUrl" class="form-control form-control-sm" /> *@
                            @* <ValidationMessage For="@(() => produto.ImageUrl)" class="text-danger small mt-1" /> *@
                        </div>

                        <div class="preview-card">
                            <h6 class="fw-bold mb-3 small text-uppercase text-muted">Definições</h6>
                            
                            <div class="settings-panel d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold text-dark"><i class="bi bi-eye me-1"></i> Estado</div>
                                    <div class="small text-muted">@(produto.Ativo ? "Visível na loja" : "Rascunho (Oculto)")</div>
                                </div>
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="produto.Ativo" class="form-check-input fs-5" />
                                </div>
                            </div>

                            <div class="settings-panel d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold text-dark"><i class="bi bi-cart me-1"></i> Venda</div>
                                    <div class="small text-muted">@(produto.ParaVenda ? "Botão comprar ativo" : "Apenas catálogo")</div>
                                </div>
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="produto.ParaVenda" class="form-check-input fs-5" />
                                </div>
                            </div>

                            <hr class="my-4 opacity-25">

                            @if (!string.IsNullOrEmpty(mensagemErro))
                            {
                                <div class="alert alert-danger small mb-3">
                                    <i class="bi bi-exclamation-circle-fill me-1"></i> @mensagemErro
                                </div>
                            }

                            <button type="submit" class="btn-submit" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span> <span>A guardar...</span>
                                }
                                else
                                {
                                    <span>GUARDAR ALTERAÇÕES <i class="bi bi-check-circle-fill ms-2"></i></span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Produto? produto;
    private string mensagemErro = string.Empty;
    private List<Categoria> categorias = new();
    private List<ModoDisponibilizacao> modos = new();

    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            
            // Carregar tudo em paralelo
            var taskProduto = ProdutoService.GetProduto(Id);
            var taskCategorias = CategoriaService.GetCategoriasAsync();
            var taskModos = ModoDispService.GetModosAsync();

            await Task.WhenAll(taskProduto, taskCategorias, taskModos);

            produto = await taskProduto;
            categorias = await taskCategorias;
            modos = await taskModos;
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro ao carregar dados.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        if (produto == null) return;

        isSaving = true;
        mensagemErro = string.Empty;

        try
        {
            await ProdutoService.UpdateProduto(produto);
            Nav.NavigateTo("/meus-produtos");
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro ao atualizar: " + ex.Message;
            isSaving = false;
        }
    }

    private async Task CarregarImagem(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && produto != null)
        {
            // Limite de tamanho (ex: 5MB)
            long maxFileSize = 1024 * 1024 * 5; 
            
            try 
            {
                using var stream = file.OpenReadStream(maxFileSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                
                produto.Imagem = ms.ToArray();
                produto.ImagemContentType = file.ContentType;
            }
            catch (Exception ex)
            {
                mensagemErro = $"Erro ao carregar imagem: {ex.Message}";
            }
        }
    }
}