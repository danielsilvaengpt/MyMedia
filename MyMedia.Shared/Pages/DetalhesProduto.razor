@page "/produtos/detalhes/{Id:int}"
@using MyMedia.Shared.Entities
@using MyMedia.Shared.Interfaces
@inject IProdutoService ProdService
@inject ICarrinhoService Carrinho
@inject NavigationManager Navigation

<PageTitle>@tituloPagina | MyMedia</PageTitle>

<div class="details-container pt-4">
    <div class="container">

        <div class="mb-4">
            <a href="/" class="back-link">
                <i class="bi bi-arrow-left"></i> Voltar à Loja
            </a>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                <p class="mt-3 text-muted fw-bold">A carregar produto...</p>
            </div>
        }
        else if (produto == null)
        {
            <div class="alert alert-warning text-center p-5 shadow-sm rounded-4">
                <i class="bi bi-search display-1 text-muted mb-3 d-block"></i>
                <h4>Produto não encontrado.</h4>
                <p class="text-muted">O produto que procuras pode ter sido removido ou não existe.</p>
                <a href="/" class="btn btn-primary mt-3 px-4 rounded-pill">Ir para o Catálogo</a>
            </div>
        }
        else
        {
            <div class="card product-details-card animate__animated animate__fadeInUp">
                <div class="row g-0">

                    <div class="col-lg-6 image-section">
                        @if (!string.IsNullOrEmpty(produto.ImageUrl))
                        {
                            <img src="@produto.ImageUrl"
                                 class="product-image"
                                 alt="@produto.Titulo"
                                 onerror="this.src='/images/placeholder.png'; this.onerror=null;">
                        }
                        else
                        {
                            <div class="text-center text-muted opacity-25">
                                <i class="bi bi-image" style="font-size: 8rem;"></i>
                                <div class="mt-2 fw-bold">Sem Imagem</div>
                            </div>
                        }

                        @if (produto.ModoDisponibilizacao != null)
                        {
                            <div class="position-absolute top-0 start-0 m-4">
                                <span class="badge bg-white text-dark shadow-sm border px-3 py-2 rounded-pill">
                                    <i class="bi bi-box-seam me-1 text-primary"></i> @produto.ModoDisponibilizacao.Nome
                                </span>
                            </div>
                        }
                    </div>

                    <div class="col-lg-6 info-section d-flex flex-column">

                        <div class="mb-2">
                            <span class="category-badge">
                                @(produto.Categoria?.Nome ?? "Geral")
                            </span>
                        </div>

                        <h1 class="product-title mb-2">@produto.Titulo</h1>

                        <div class="product-price">
                            @produto.PrecoFinal.ToString("C")
                        </div>

                        <div class="mb-4 description-text">
                            @produto.Descricao
                        </div>

                        <div class="meta-box mb-4">
                            <div class="row g-3">
                                <div class="col-6 border-end">
                                    <div class="meta-label">Disponibilidade</div>
                                    <div class="meta-value">
                                        @if (produto.Stock > 0)
                                        {
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                            <span>Em Stock (@produto.Stock)</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle-fill text-danger"></i>
                                            <span class="text-danger">Esgotado</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-6 ps-4">
                                    <div class="meta-label">Vendido por</div>
                                    <div class="meta-value">
                                        <i class="bi bi-shop text-primary"></i>
                                        <span class="text-truncate">@(produto.Fornecedor?.UserName ?? "MyMedia Partner")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-auto">
                            @if (produto.ParaVenda && produto.Stock > 0)
                            {
                                <button class="btn-add-cart shadow-sm" @onclick="AdicionarAoCarrinho">
                                    <i class="bi bi-bag-plus me-2"></i> Adicionar ao Carrinho
                                </button>
                            }
                            else if (!produto.ParaVenda)
                            {
                                <button class="btn-add-cart" disabled>
                                    <i class="bi bi-eye-slash me-2"></i> Indisponível para Venda
                                </button>
                                <small class="d-block text-center mt-2 text-muted">Este produto é apenas para consulta.</small>
                            }
                            else
                            {
                                <button class="btn-add-cart" disabled>
                                    <i class="bi bi-emoji-frown me-2"></i> Sem Stock
                                </button>
                                <small class="d-block text-center mt-2 text-muted">Recebe um alerta quando estiver disponível.</small>
                            }
                        </div>

                        <div class="mt-4 pt-3 border-top text-center text-muted small">
                            <i class="bi bi-shield-check me-1"></i> Compra Segura &middot;
                            <i class="bi bi-truck me-1 ms-2"></i> Envio Rápido
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Produto? produto;
    private bool isLoading = true;
    private string tituloPagina = "Detalhes do Produto";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            // Usa o IProdutoService para buscar os dados à API
            produto = await ProdService.GetProdutoAsync(Id);

            if (produto != null)
            {
                tituloPagina = produto.Titulo;

                // Se o produto não estiver ativo (Pendente), redireciona o utilizador público para fora
                if (!produto.Ativo)
                {
                    produto = null;
                }
            }
        }
        catch (Exception)
        {
            // Log de erro opcional
            produto = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AdicionarAoCarrinho()
    {
        if (produto != null)
        {
            await Carrinho.AdicionarItem(produto);
            // Feedback opcional ou navegação
            // Navigation.NavigateTo("/carrinho");
        }
    }
}