@using MyMedia.Shared.Entities

@if (Produto != null)
{
    <div class="card border-0 shadow-lg overflow-hidden mt-4 product-highlight-card">
        <div class="row g-0 align-items-center">

            @* Lado Esquerdo: Imagem (Agora mais pequena) *@
            <div class="col-md-4 bg-white d-flex align-items-center justify-content-center p-3">
                @if (!string.IsNullOrEmpty(Produto.ImageUrl))
                {
                    <img src="@Produto.ImageUrl" class="img-fluid highlight-img" alt="@Produto.Titulo">
                }
                else
                {
                    <i class="bi bi-star-fill text-warning" style="font-size: 3rem;"></i>
                }
            </div>

            @* Lado Direito: Conteúdo Compacto *@
            <div class="col-md-8 highlight-content text-white">
                <div class="card-body p-3 p-lg-4 d-flex flex-column justify-content-center h-100">

                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-warning text-dark px-2 py-1 rounded-pill shadow-sm text-uppercase fw-bold" style="font-size: 0.7rem;">
                            <i class="bi bi-stars me-1"></i> Destaque
                        </span>
                    </div>

                    <h3 class="card-title fw-bold mb-2">@Produto.Titulo</h3>

                    <p class="card-text opacity-90 mb-3 small d-none d-md-block">
                        @(Produto.Descricao.Length > 120 ? Produto.Descricao.Substring(0, 120) + "..." : Produto.Descricao)
                    </p>

                    <div class="d-flex align-items-center justify-content-between mt-auto">
                        <h4 class="mb-0 fw-bold">@Produto.PrecoFinal.ToString("C")</h4>

                        <a href="/produtos/detalhes/@Produto.Id" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-pill shadow-sm btn-offer btn-sm">
                            Ver Oferta <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public Produto? Produto { get; set; }
}