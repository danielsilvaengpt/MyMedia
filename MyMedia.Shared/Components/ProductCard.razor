@using MyMedia.Shared.Entities
@using MyMedia.Shared.Interfaces
@inject ICarrinhoService Carrinho



<div class="product-card d-flex flex-column">

    @* 1. IMAGEM *@
    <div class="img-wrapper">
        @if (!string.IsNullOrEmpty(Produto.ImageUrl))
        {
            <img src="@Produto.ImageUrl" class="card-img-top" alt="@Produto.Titulo"
                 style="@(Produto.Stock <= 0 ? "filter: grayscale(100%);" : "")">
        }
        else
        {
            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                <i class="bi bi-image" style="font-size: 3rem; opacity: 0.3;"></i>
            </div>
        }

        @* Overlay Esgotado *@
        @if (Produto.Stock <= 0)
        {
            <div class="sold-out-overlay">
                <span class="badge bg-dark text-uppercase px-3 py-2 fs-6 shadow">Esgotado</span>
            </div>
        }
    </div>

    @* 2. CORPO *@
    <div class="card-body d-flex flex-column p-3">

        <div class="mb-2 d-flex gap-2">
            <span class="custom-badge badge-cat text-truncate" style="max-width: 120px;">
                @(Produto.Categoria?.Nome ?? "Geral")
            </span>
            @if (Produto.ModoDisponibilizacao != null)
            {
                <span class="custom-badge badge-mode">
                    @Produto.ModoDisponibilizacao.Nome
                </span>
            }
        </div>

        <a href="/produtos/detalhes/@Produto.Id" class="text-decoration-none">
            <h5 class="product-title" title="@Produto.Titulo">@Produto.Titulo</h5>
        </a>

        <div class="mt-auto">
            <div class="d-flex justify-content-between align-items-end mb-3">
                <div class="price-text">
                    @Produto.PrecoFinal.ToString("C")
                </div>

                @if (Produto.Stock > 0 && Produto.Stock < 5)
                {
                    <small class="text-danger fw-bold animate__animated animate__pulse animate__infinite" style="font-size: 0.75rem;">
                        <i class="bi bi-fire"></i> Restam @Produto.Stock
                    </small>
                }
            </div>

            <div class="d-grid gap-2">
                @if (Produto.ParaVenda)
                {
                    @if (Produto.Stock > 0)
                    {
                        @if (mostrarSucesso)
                        {
                            <button class="btn btn-success btn-sm fw-bold border-0" disabled>
                                <i class="bi bi-check-lg"></i> Adicionado!
                            </button>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <a href="/produtos/detalhes/@Produto.Id" class="btn btn-outline-custom btn-sm flex-grow-1">
                                    Detalhes
                                </a>
                                <button class="btn btn-gradient btn-sm flex-grow-1 rounded-3" @onclick="AdicionarAoCarrinho">
                                    <i class="bi bi-bag-plus-fill me-1"></i> Adicionar
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <a href="/produtos/detalhes/@Produto.Id" class="btn btn-outline-secondary btn-sm w-100 disabled" style="opacity: 0.6;">
                            Indisponível
                        </a>
                    }
                }
                else
                {
                    <a href="/produtos/detalhes/@Produto.Id" class="btn btn-outline-custom btn-sm w-100">
                        <i class="bi bi-eye"></i> Ver Detalhes
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Produto Produto { get; set; } = new();

    private bool mostrarSucesso = false;

    private async Task AdicionarAoCarrinho()
    {
        if (Produto != null && Produto.Stock > 0)
        {
            bool sucesso = await Carrinho.AdicionarItem(Produto);

            if (sucesso)
            {
                mostrarSucesso = true;
                StateHasChanged();
                await Task.Delay(1500);
                mostrarSucesso = false;
                StateHasChanged(); // Garante que o botão volta ao normal
            }
        }
    }
}