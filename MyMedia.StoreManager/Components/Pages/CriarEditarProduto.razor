@page "/produtos/criar"
@page "/produtos/editar/{id:int}"
@using Microsoft.AspNetCore.Authorization
@using MyMedia.Shared.Entities
@using MyMedia.StoreManager.Services
@inject ProdutoService Service
@inject ModoDisponibilizacaoService ModoService
@inject NavigationManager NavManager
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Administrador,Funcionario")]

<PageTitle>@(Id == null ? "Novo Produto" : "Editar Produto") | Admin</PageTitle>


<div class="admin-container">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="page-title mb-0">
                    @(Id == null ? "Novo Produto" : "Editar Produto")
                </h2>
                <a href="/produtos" class="btn btn-sm btn-outline-secondary border-0 rounded-circle p-2" title="Fechar">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>

            <div class="admin-card">
                <EditForm Model="produto" OnValidSubmit="GravarProduto">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger mb-4" />

                    <div class="row g-4">

                        <div class="col-md-7">
                            <h6 class="text-uppercase text-muted mb-3 fw-bold small">Informação Básica</h6>

                            <div class="mb-3">
                                <label class="form-label">Título do Produto</label>
                                <InputText class="form-control" @bind-Value="produto.Titulo" placeholder="Ex: Sony Alpha a7 III..." />
                                <ValidationMessage For="@(() => produto.Titulo)" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Descrição Detalhada</label>
                                <InputTextArea class="form-control" @bind-Value="produto.Descricao" rows="6" placeholder="Descreve as características..." />
                                <ValidationMessage For="@(() => produto.Descricao)" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Imagem do Produto (Capa)</label>
                                <InputFile OnChange="CarregarImagem" class="form-control" accept=".jpg,.jpeg,.png" />
                                @if (!string.IsNullOrEmpty(produto.ImageUrl))
                                {
                                    <div class="mt-2 text-center p-2 border rounded bg-light">
                                        <img src="@produto.ImageUrl" alt="Pré-visualização" style="max-height: 200px; max-width: 100%; object-fit: contain;" />
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-5">
                            <h6 class="text-uppercase text-muted mb-3 fw-bold small">Definições de Loja</h6>

                            <div class="bg-light p-3 rounded mb-3">
                                <div class="mb-3">
                                    <label class="form-label small">Categoria</label>
                                    <InputSelect class="form-select" @bind-Value="produto.CategoriaId">
                                        <option value="0">-- Selecione --</option>
                                        @foreach (var cat in listaCategorias)
                                        {
                                            <option value="@cat.Id">@cat.Nome</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Fornecedor (Dono)</label>
                                    <InputSelect class="form-select" @bind-Value="produto.FornecedorId">
                                        <option value="">-- Selecione --</option>
                                        @foreach (var user in listaFornecedores)
                                        {
                                            <option value="@user.Id">@user.UserName</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label class="form-label small">Modo de Entrega</label>
                                    <InputSelect @bind-Value="produto.ModoDisponibilizacaoId" class="form-select">
                                        <option value="0">-- Selecione --</option>
                                        @foreach (var modo in modos)
                                        {
                                            <option value="@modo.Id">@modo.Nome</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label">Preço Base (€)</label>
                                    <InputNumber class="form-control" @bind-Value="produto.PrecoBase" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Margem (%)</label>
                                    <InputNumber class="form-control" @bind-Value="produto.PercentagemMargem" />
                                </div>
                            </div>

                            <div class="alert alert-info py-2 px-3 small d-flex justify-content-between align-items-center">
                                <span>Preço Final:</span>
                                <strong class="fs-6">@produto.PrecoFinal.ToString("C")</strong>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Stock Inicial</label>
                                <InputNumber class="form-control" @bind-Value="produto.Stock" />
                            </div>

                            <div class="d-flex flex-column gap-2 border-top pt-3">
                                <div class="form-check form-switch d-flex align-items-center justify-content-between ps-0">
                                    <label class="form-check-label fw-bold" for="chkAtivo">Visível na Loja (Ativo)</label>
                                    <InputCheckbox class="form-check-input ms-0" @bind-Value="produto.Ativo" id="chkAtivo" />
                                </div>
                                <div class="form-check form-switch d-flex align-items-center justify-content-between ps-0">
                                    <label class="form-check-label fw-bold" for="chkVenda">Disponível para Venda</label>
                                    <InputCheckbox class="form-check-input ms-0" @bind-Value="produto.ParaVenda" id="chkVenda" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 opacity-10">

                    <div class="d-flex justify-content-end gap-3">
                        <a href="/produtos" class="btn btn-cancel">Cancelar</a>
                        <button type="submit" class="btn btn-save">
                            <i class="bi bi-check-lg me-2"></i> Gravar Produto
                        </button>
                    </div>

                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private Produto produto = new Produto();
    private List<Categoria> listaCategorias = new();
    private List<ApplicationUser> listaFornecedores = new();
    private List<ModoDisponibilizacao> modos = new();

    protected override async Task OnInitializedAsync()
    {
        // 1. Carregar Dados Auxiliares
        listaCategorias = await Service.GetCategoriasAsync();
        listaFornecedores = await Service.GetFornecedoresAsync();
        var todosModos = await ModoService.GetAll();
        modos = todosModos.Where(m => m.Ativo).ToList();

        // 2. Carregar Produto ou Criar Novo
        if (Id != null)
        {
            var produtoExistente = await Service.GetProdutoByIdAsync(Id.Value);
            if (produtoExistente != null)
            {
                produto = produtoExistente;
            }
        }
        else
        {
            produto.Ativo = true;
            produto.ParaVenda = true;
        }
    }

    private async Task GravarProduto()
    {
        // Validação Manual Opcional
        if (produto.CategoriaId == 0) return;

        await Service.SaveProdutoAsync(produto);
        NavManager.NavigateTo("/produtos");
    }

    private async Task CarregarImagem(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            // Limite de tamanho (ex: 5MB)
            long maxFileSize = 1024 * 1024 * 5; 
            
            try 
            {
                using var stream = file.OpenReadStream(maxFileSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                
                produto.Imagem = ms.ToArray();
                produto.ImagemContentType = file.ContentType;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao carregar imagem: {ex.Message}");
            }
        }
    }
}