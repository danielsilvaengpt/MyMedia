@implements IDisposable

@inject NavigationManager NavigationManager

<div class="sidebar-container d-flex flex-column">

    <div class="admin-brand">
        <i class="bi bi-shield-lock-fill text-primary"></i>
        <span>MyMedia <span class="fw-light opacity-75">Manager</span></span>
    </div>

    <button title="Navigation menu" class="navbar-toggler d-md-none border-0 text-white" type="button" onclick="document.querySelector('.nav-scrollable').classList.toggle('show')">
        <i class="bi bi-list fs-2"></i>
    </button>

    <div class="nav-scrollable d-flex flex-column flex-grow-1 justify-content-between">
        <nav class="flex-column pt-3">

            <div class="nav-item">
                <NavLink class="nav-link nav-link-admin" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-speedometer2" aria-hidden="true"></span> Inicio
                </NavLink>
            </div>

            <div class="text-uppercase small fw-bold text-muted mt-3 mb-2 px-4" style="font-size: 0.75rem;">Gestão de Loja</div>

            <div class="nav-item">
                <NavLink class="nav-link nav-link-admin" href="produtos">
                    <span class="bi bi-box-seam-fill" aria-hidden="true"></span> Produtos
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link nav-link-admin" href="categorias">
                    <span class="bi bi-tags-fill" aria-hidden="true"></span> Categorias
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link nav-link-admin" href="modos">
                    <span class="bi bi-hdd-network-fill" aria-hidden="true"></span> Modos Disp.
                </NavLink>
            </div>

            <div class="text-uppercase small fw-bold text-muted mt-3 mb-2 px-4" style="font-size: 0.75rem;">Administração</div>

            <div class="nav-item">
                <NavLink class="nav-link nav-link-admin" href="encomendas">
                    <span class="bi bi-receipt" aria-hidden="true"></span> Vendas / Pedidos
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link nav-link-admin" href="utilizadores">
                    <span class="bi bi-people-fill" aria-hidden="true"></span> Utilizadores
                </NavLink>
            </div>

        </nav>

        <div class="user-section pb-4">
            <AuthorizeView>
                <Authorized>
                    <div class="nav-item px-3 mb-2">
                        <NavLink class="nav-link nav-link-admin" href="Account/Manage">
                            <span class="bi bi-person-circle" aria-hidden="true"></span>
                            <span class="text-truncate">@context.User.Identity?.Name</span>
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="nav-link nav-link-admin logout-btn">
                                <span class="bi bi-box-arrow-left" aria-hidden="true"></span> Sair
                            </button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="nav-item px-3 mb-2">
                        <NavLink class="nav-link nav-link-admin" href="Account/Login">
                            <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Entrar
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
